    {
      "parameters": {
        "jsCode": "function parseList(node) {\n  try {\n    const t = $(node).item.json.data ?? $(node).item.json;\n    const v = typeof t === 'string' ? JSON.parse(t) : t;\n    return Array.isArray(v) ? v : [];\n  } catch (e) { return []; }\n}\n\nconst item = $('Checar Escopo Sensivel').item.json;\nconst agenda = parseList('GET Agenda');\nconst avisos = parseList('GET Avisos');\nconst cardapio = parseList('GET Cardapio')[0] ?? null;\n\nconst contextoAgenda = agenda\n  .map((e) => `- ${e.data}: ${e.titulo}${e.descricao ? ' — ' + e.descricao : ''}`)\n  .join('\\n') || 'Nenhum evento cadastrado.';\nconst contextoAvisos = avisos\n  .map((a) => `- ${a.titulo}: ${a.mensagem}`)\n  .join('\\n') || 'Nenhum aviso recente.';\nconst contextoCardapio = cardapio\n  ? `Semana de ${cardapio.semana_inicio}: seg ${cardapio.segunda}, ter ${cardapio.terca}, qua ${cardapio.quarta}, qui ${cardapio.quinta}, sex ${cardapio.sexta}`\n  : 'Cardápio não disponível no momento.';\n\nconst systemPrompt = \"Você é o assistente virtual do Colégio Raio de Luz, respondendo dúvidas de pais e responsáveis pelo aplicativo do colégio. Responda SOMENTE com base nas informações fornecidas no contexto abaixo (agenda, avisos e cardápio reais da escola). Se a informação pedida não estiver no contexto, diga claramente que não sabe e sugira falar com a secretaria — nunca invente dado (frequência, ocorrência, saúde do aluno). Seja breve, gentil, em português do Brasil.\";\n\nconst userPrompt = `Aluno: ${item.responsavelAluno ?? 'não informado'} (turma ${item.responsavelTurma ?? 'não informada'})\\n\\n` +\n  `Agenda:\\n${contextoAgenda}\\n\\n` +\n  `Avisos:\\n${contextoAvisos}\\n\\n` +\n  `Cardápio:\\n${contextoCardapio}\\n\\n` +\n  `Pergunta do responsável: ${item.texto}`;\n\nreturn [{ json: { ...item, systemPrompt, userPrompt } }];"
      },
