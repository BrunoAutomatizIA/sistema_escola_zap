      "parameters": {
        "jsCode": "// Lista simples de palavras-chave — gatilho conservador: melhor escalar demais do que\n// deixar a IA responder algo sensível sem saber (ver specs/comunicacao-mensagens.md § 5).\n// REVISAR/AMPLIAR esta lista ao importar o workflow no n8n.\nconst PALAVRAS_SENSIVEIS = [\n  'saude', 'saúde', 'doente', 'doenca', 'doença', 'remedio', 'remédio', 'alergia', 'alergica', 'alérgica',\n  'machucou', 'machucado', 'febre', 'passou mal', 'hospital', 'medico', 'médico',\n  'reclamacao', 'reclamação', 'reclamar', 'reclamo', 'insatisfeit',\n  'bullying', 'briga', 'brigou', 'agrediu', 'agressao', 'agressão',\n  'ocorrencia', 'ocorrência', 'processo', 'advogado', 'juridico', 'jurídico',\n];\nconst item = $input.first().json;\nconst textoNormalizado = (item.texto || '').toLowerCase();\nconst sensivel = PALAVRAS_SENSIVEIS.some((p) => textoNormalizado.includes(p));\nreturn [{ json: { ...item, sensivel } }];"
      },
