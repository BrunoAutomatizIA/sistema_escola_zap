        "jsCode": "const item = $input.first().json;\nlet texto = 'Desculpa, não consegui pensar numa resposta agora — tenta de novo em instantes ou fala com a secretaria.';\ntry {\n  const t = item.data ?? item;\n  const parsed = typeof t === 'string' ? JSON.parse(t) : t;\n  if (parsed?.message?.content) texto = parsed.message.content.trim();\n} catch (e) { /* mantém a mensagem de fallback */ }\nreturn [{ json: { responsavelId: item.responsavelId, texto } }];"
