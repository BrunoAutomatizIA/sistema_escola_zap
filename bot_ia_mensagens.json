        "jsCode": "const item = $input.first().json;\nconst textoIa = 'Recebi sua mensagem! Como esse assunto precisa de atenção da equipe da escola, ' +\n  'já avisei a secretaria e alguém vai te responder em breve por aqui ou pelo WhatsApp.';\nconst textoEscola = `📩 *Handoff Mensagens (IA)*\\n\\n` +\n  `Responsável: ${item.responsavelNome ?? 'não identificado'} (${item.responsavelTelefone ?? 'sem telefone'})\\n` +\n  `Aluno: ${item.responsavelAluno ?? '-'} — Turma: ${item.responsavelTurma ?? '-'}\\n\\n` +\n  `Pergunta: ${item.texto}`;\nreturn [{ json: { ...item, textoIa, textoEscola } }];"
